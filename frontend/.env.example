# Blockchain Configuration
# Network: hardhat (local), sepolia (Chainlink), mumbai (legacy), polygon (mainnet)
NEXT_PUBLIC_NETWORK=sepolia
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://rpc.sepolia.org

# For Hardhat Local (uncomment for local dev)
# NEXT_PUBLIC_NETWORK=hardhat
# NEXT_PUBLIC_CHAIN_ID=31337
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# For Mumbai Testnet (legacy)
# NEXT_PUBLIC_NETWORK=mumbai
# NEXT_PUBLIC_CHAIN_ID=80001
# NEXT_PUBLIC_RPC_URL=https://rpc-mumbai.maticvigil.com

# For Polygon Mainnet (production)
# NEXT_PUBLIC_NETWORK=polygon
# NEXT_PUBLIC_CHAIN_ID=137
# NEXT_PUBLIC_RPC_URL=https://polygon-rpc.com

# Contract Addresses (Update with actual deployment addresses)
NEXT_PUBLIC_CARBON_CREDIT_NFT=0x
NEXT_PUBLIC_CARBON_CREDIT_TOKEN=0x
NEXT_PUBLIC_CARBON_MARKETPLACE=0x
NEXT_PUBLIC_CARBON_PRICE_ORACLE=0x
NEXT_PUBLIC_EMISSION_VERIFIER=0x

# WalletConnect Project ID (Get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Payment Token (USDC address for your network)
NEXT_PUBLIC_USDC_ADDRESS=0x

# Backend API
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud

# Feature Flags
NEXT_PUBLIC_ENABLE_MAINNET=false
NEXT_PUBLIC_ENABLE_AUCTIONS=true
NEXT_PUBLIC_ENABLE_INVESTMENTS=true
NEXT_PUBLIC_ENABLE_STAKING=true

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Feature flags
NEXT_PUBLIC_ENABLE_ONCHAIN_COMPANY_REGISTRATION=false
